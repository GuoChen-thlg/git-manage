{
  "name": "git-manager-vscode",
  "displayName": "Git Manager",
  "description": "IntelliJ 风格的 Git 管理面板：分支树、提交图、差异对比与常用 git 操作",
  "version": "0.0.1",
  "publisher": "guochen",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "scm",
    "branch",
    "history"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitManager",
          "title": "Git Manager",
          "icon": "media/git.svg"
        }
      ],
      "panel": [
        {
          "id": "gitManagerPanel",
          "title": "Git Manager",
          "icon": "media/git.svg"
        }
      ]
    },
    "views": {
      "gitManager": [
        {
          "id": "gitManager.branches",
          "name": "分支",
          "icon": "media/git.svg"
        },
        {
          "id": "gitManager.commits",
          "name": "提交",
          "icon": "media/git.svg"
        }
      ],
      "gitManagerPanel": [
        {
          "type": "webview",
          "id": "gitManager.panelView",
          "name": "Git Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "gitManager.openPanel",
        "title": "打开完整面板",
        "category": "Git Manager"
      },
      {
        "command": "gitManager.refresh",
        "title": "刷新",
        "category": "Git Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "gitManager.checkoutBranch",
        "title": "切换分支",
        "category": "Git Manager"
      },
      {
        "command": "gitManager.createBranch",
        "title": "新建分支",
        "category": "Git Manager"
      },
      {
        "command": "gitManager.deleteBranch",
        "title": "删除分支",
        "category": "Git Manager",
        "icon": "$(trash)"
      },
      {
        "command": "gitManager.renameBranch",
        "title": "重命名分支",
        "category": "Git Manager"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitManager.refresh",
          "when": "view =~ /^gitManager\\./",
          "group": "navigation@1"
        },
        {
          "command": "gitManager.openPanel",
          "when": "view =~ /^gitManager\\./",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gitManager.checkoutBranch",
          "when": "view == gitManager.branches && viewItem == localBranch",
          "group": "1_checkout@1"
        },
        {
          "command": "gitManager.renameBranch",
          "when": "view == gitManager.branches && viewItem == localBranch",
          "group": "2_edit@1"
        },
        {
          "command": "gitManager.deleteBranch",
          "when": "view == gitManager.branches && viewItem =~ /Branch$/",
          "group": "2_edit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitManager.deleteBranch",
          "when": "false"
        },
        {
          "command": "gitManager.renameBranch",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.integration.json",
    "pack": "node scripts/pack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:integration": "node scripts/build-integration.mjs",
    "test:integration": "node scripts/build-integration.mjs && vscode-test"
  },
  "dependencies": {
    "@git-manage/core": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}

{
  "name": "git-manage",
  "version": "0.0.2",
  "private": true,
  "description": "Git management tool for OpenChamber and VSCode",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter git-manager dev",
    "build": "pnpm -r build",
    "prepare": "husky",
    "test": "vitest",
    "mutation": "stryker run",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "pnpm -r typecheck",
    "test:blackbox": "pnpm --filter git-manager run test:blackbox",
    "test:vscode": "pnpm --filter git-manager-vscode run test",
    "test:all": "vitest run && pnpm --filter git-manager-vscode run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "packageExtensions": {
      "@stryker-mutator/core": {
        "dependencies": {
          "@stryker-mutator/vitest-runner": "10.0.0"
        }
      }
    }
  }
}
